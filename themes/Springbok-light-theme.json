      "settings": {
        "foreground": "#383838"
      }
    },
    {
      "scope": [
        "meta.import variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#383838"
      }
    },
    {
      "scope": [
        "meta.import variable.other.readwrite.alias"
      ],
      "settings": {
        "foreground": "#383838"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#014179"
      }
    },
    {
      "scope": [
        "meta.definition.property"
      ],
      "settings": {
        "foreground": "#0A4170"
      }
    },
    {
      "scope": [
        "support.type.builtin",
        "support.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#014179",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#790501"
      }
    },
    {
      "scope": "support.class.component",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.tag.attributes punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#111100"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.jsx.children punctuation.section.embedded",
        "meta.tag.attributes meta.jsx.children punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#993800"
      }
    },
    {
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#794901"
      }
    },
    {
      "scope": [
