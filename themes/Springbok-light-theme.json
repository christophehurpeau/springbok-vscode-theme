  "semanticTokenColors": {
    "enumMember": {
      "fontStyle": "bold italic"
    },
    "variable.constant": {
      "bold": true
    },
    "type": {
      "foreground": "#014179"
    },
    "interface": {
      "foreground": "#014179"
    },
    "class": {
      "foreground": "#080808",
      "bold": true
    },
    "class.defaultLibrary": {
      "foreground": "#080808",
      "fontStyle": "bold"
    },
    "function": {
      "foreground": "#8A44D5"
    },
    "function.defaultLibrary": {
      "foreground": "#D54944",
      "fontStyle": "bold"
    },
    "variable.defaultLibrary": {
      "foreground": "#B61611"
    },
    "parameter": {
      "italic": true
    },
    "*.static": {
      "bold": true
    }
  },
  "tokenColors": [
    {
      "scope": [
        "constant.numeric",
        "constant.numeric keyword.other.unit",
        "constant.other.timestamp"
      ],
      "settings": {
        "foreground": "#C50802"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#C57702"
      }
    },
    {
      "name": "Escape",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#993800"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#993800"
      }
    },
    {
      "scope": "meta.template.expression",
      "settings": {
        "foreground": "#111100"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#70660A"
      }
    },
    {
      "name": "Regex Character Class + Escape",
      "scope": "constant.character.escape.backslash.regexp",
      "settings": {
        "foreground": "#D54944"
      }
    },
    {
      "name": "Regex Group/Set",
      "scope": [
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#796D01"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#D54944"
      }
    },
    {
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.block"
      ],
      "settings": {
        "foreground": "#9f9f9f"
      }
    },
    {
      "name": "Comment Documentation",
      "scope": [
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#6A8759"
      }
    },
    {
      "name": "JsDoc",
      "scope": [
        "storage.type.class.jsdoc",
        "punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#6A8759",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "JsDoc Parameter name",
      "scope": "variable.other.jsdoc",
      "settings": {
        "foreground": "#629755",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B55A26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#B55A26"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B61611"
      }
    },
    {
      "name": "Keys",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#794901"
      }
    },
    {
      "scope": [
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#E189D5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#797979",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#8A44D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Language",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#B55A26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#383838",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#0A4170",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "entity.name.variable",
        "meta.definition.variable",
        "variable.object.property"
