{
  "name": "springbok-theme",
  "displayName": "Springbok Theme",
  "version": "0.14.1",
  "description": "Springbok Theme",
  "categories": [
    "Themes"
  ],
  "license": "MIT",
  "repository": "https://github.com/christophehurpeau/springbok-vscode-theme.git",
  "publisher": "chrp",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "node scripts/generate-theme.ts",
    "package": "pnpm run typecheck && pnpm run generate",
    "package:vsce": "vsce package --no-dependencies",
    "prepare": "pob-root-postinstall",
    "screenshots": "node scripts/screenshots.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pob/root": "27.15.0",
    "@types/color-convert": "2.0.4",
    "@types/node": "22.13.5",
    "@types/react": "18.0.17",
    "@types/react-dom": "18.0.6",
    "@vscode/vsce": "4.0.0",
    "color-convert": "2.0.1",
    "ovsx": "1.2.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "contributes": {
    "themes": [
      {
        "label": "Springbok Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/Springbok-legacy-theme.json"
      },
      {
        "label": "Dark Springbok",
        "uiTheme": "vs-dark",
        "path": "./themes/Springbok-dark-theme.json"
      },
      {
        "label": "Light Springbok",
        "uiTheme": "vs",
        "path": "./themes/Springbok-light-theme.json"
      }
    ]
  },
  "icon": "images/springbok-logo.png",
  "galleryBanner": {
    "color": "#B55A26",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.47.0"
  },
  "packageManager": "pnpm@12.10.1"
}
