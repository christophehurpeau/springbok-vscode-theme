{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "sortPackageJson": { "sortScripts": true },
  "ignorePatterns": [
    "CHANGELOG.md",
    "pnpm-lock.yaml",
    // regenerated by pob-root-postinstall on every install
    "/.github/workflows/push-renovate-*.yml",
    "/themes/*.json",
    "/examples",
  ],
}
